# luwte-dev — development only. Never the project holding real family data.
#
# These values are committed on purpose. A Firebase web API key is a public
# identifier, not a secret: it ships inside every deployed web bundle and is
# visible to anyone who opens devtools. Access is controlled by Firestore
# security rules, not by hiding this key.
#
# Production values live in .env.production.local, which stays out of git —
# not because they are secret either, but so that pointing a build at the
# database holding real health records has to be a deliberate act.
#
# Regenerate with:
#   firebase apps:sdkconfig WEB --project luwte-dev

VITE_FIREBASE_API_KEY=AIzaSyBvpxXm7Z-ep3XHt9S0T_cabT-PRfuniFY
VITE_FIREBASE_AUTH_DOMAIN=luwte-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=luwte-dev
VITE_FIREBASE_STORAGE_BUCKET=luwte-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=364811383716
VITE_FIREBASE_APP_ID=1:364811383716:web:eecb61926b2140d9be0731

# Point the app at the local emulators rather than the cloud project.
# Keep this on for development: it means no real email is ever sent and no
# cloud data is touched while building.
VITE_USE_EMULATORS=true
