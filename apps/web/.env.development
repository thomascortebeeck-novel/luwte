# Local development. This points at NO real Firebase project.
#
# The project id starts with `demo-`, which Firebase treats specially: the
# SDKs and the emulator suite both refuse to contact live Google services for
# such a project. That turns a misconfiguration into a loud failure instead of
# a silent write to a database holding a real person's health records.
#
# It also means local development needs no Firebase project at all — clone the
# repo, `pnpm emulators`, `pnpm dev`, and everything works.
#
# The key and sender id below are placeholders. They are never sent anywhere.

VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-luwte.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-luwte
VITE_FIREBASE_STORAGE_BUCKET=demo-luwte.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Belt and braces. Even without this, `demo-` cannot reach the cloud.
VITE_USE_EMULATORS=true
