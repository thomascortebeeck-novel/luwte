# Copy to .env.production.local for a production build.
# Read the values with: firebase apps:sdkconfig WEB --project luwte-prod

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must be absent or false for anything pointing at real data.
VITE_USE_EMULATORS=false
