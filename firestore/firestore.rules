rules_version = '2';

/*
 * Phase 1 — self-only access.
 *
 * PRD 5.3 makes the circle document the access control list, and every read
 * of patient data will resolve through it. The circle does not exist yet, so
 * this ruleset grants a person access to their own data and to nothing else.
 * Phase 6 adds the circle rows on top; the self rows below do not change.
 *
 * The rule that matters most, when the circle arrives: circle/** stays
 * writable by the patient only. A family member must never be able to widen
 * their own access, and during an episode the temptation to do so is real.
 *
 * Default deny is the last match in the file. Anything not named here is
 * refused.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Identity and settings. Nothing clinical lives here.
    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      // Account deletion goes through the GDPR Art. 17 Cloud Function, which
      // cascades. A client-side delete would orphan the subtree.
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, create, update: if isSelf(patientId);
      allow delete: if false;

      /*
       * GDPR Art. 9 consent log. Append-only by design: a consent record that
       * can be erased is not a record. Withdrawal is an update that sets
       * withdrawnAt, never a delete.
       */
      match /consents/{consentId} {
        allow read: if isSelf(patientId);
        allow create: if isSelf(patientId)
                      && request.resource.data.version is string
                      && request.resource.data.grants.essential == true
                      && request.resource.data.grants.healthData == true;
        allow update: if isSelf(patientId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
