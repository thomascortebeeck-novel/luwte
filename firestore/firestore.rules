rules_version = '2';

// Phase 0 stub. Phase 1 replaces this with the PRD 5.3 matrix, where the
// circle document IS the access control list and every read of patient data
// resolves through it.
//
// The row that matters most, when it is written: circle/** is writable by the
// patient only. A family member must never be able to widen their own access,
// and during an episode the temptation to do so is real.
//
// Until then nothing is readable and nothing is writable. A permissive
// default on health data is not a mistake worth risking.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
