rules_version = '2';

/*
 * PRD 5.3 — the circle document IS the access control list. Every read of
 * patient data resolves through it.
 *
 * The rule that matters most: **circle/** is writable by the patient only.**
 * A family member must never be able to widen their own access, and during an
 * episode the temptation to do so is real. Read the `circle` match block with
 * that sentence in mind; everything else here is detail.
 *
 * Default deny is the last match in the file. Anything not named is refused.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** The reader's own entry in this patient's circle, or null. */
    function circleDoc(pid) {
      return get(/databases/$(database)/documents/patients/$(pid)/circle/$(request.auth.uid)).data;
    }

    function inCircle(pid) {
      return signedIn()
             && exists(/databases/$(database)/documents/patients/$(pid)/circle/$(request.auth.uid));
    }

    /*
     * Granted only while the membership is live and that specific permission
     * is on. Revocation sets revokedAt, so access ends the moment it is set
     * without deleting the record of it having existed.
     */
    function granted(pid, key) {
      return inCircle(pid)
             && circleDoc(pid).revokedAt == null
             && circleDoc(pid).permissions[key] == true;
    }

    /** Self, or a circle member the patient granted this specific key to. */
    function canRead(pid, key) {
      return isSelf(pid) || granted(pid, key);
    }

    /*
     * Medication and doses are a clinician's business and nobody else's.
     *
     * Family and friends are never offered the toggle, and the role is
     * checked here as well — so a supporter card that somehow carries
     * `medication: true` still grants nothing. What someone is prescribed is
     * the most diagnostic thing this database holds, and a permission that
     * cannot be granted to the wrong person cannot leak to them on a bad day.
     */
    function canReadClinical(pid) {
      return isSelf(pid)
             || (granted(pid, 'medication') && circleDoc(pid).role == 'clinician');
    }

    function inviteData(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }

    /*
     * PRD 6.7 — "checked manually at first". Verification is an out-of-band
     * admin act: a document in `clinicians/` that nobody may write from a
     * client. If it could be claimed in-band, "verified clinician" would mean
     * nothing, and a patient could anoint anyone — including themselves — as
     * the person who decides what they are prescribed.
     *
     * A document rather than a custom claim, because Auth is deliberately
     * kept to an email and auth machinery only (PRD 5.5 option 1), and
     * because a claim needs a token refresh before it takes effect.
     */
    function isVerifiedClinician() {
      return signedIn()
             && exists(/databases/$(database)/documents/clinicians/$(request.auth.uid));
    }

    /*
     * The one thing no client may write, and therefore the root of everything
     * above it.
     *
     * Verification moved from a shell script into an admin panel (D27), which
     * moved the root of trust rather than removing it: `clinicians/` is now
     * written by an admin from the app, and `admins/` is written only with the
     * Admin SDK. The invariants are unchanged — nobody verifies themselves,
     * and no patient can anoint a clinician.
     */
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /*
     * A circle card naming somebody as a clinician requires that they actually
     * are one.
     *
     * The patient's word decides *whose* clinician they are; it cannot decide
     * *that they are one*. Without this, a patient could hand anyone a
     * clinician card and that person would read their medication — and being
     * persuaded to name someone "my doctor" is a thing that happens during an
     * episode. Same reasoning as D23: a permission that cannot be granted to
     * the wrong person cannot leak to them on a bad day.
     */
    function clinicianIsVerified(memberUid) {
      return request.resource.data.role != 'clinician'
             || exists(/databases/$(database)/documents/clinicians/$(memberUid));
    }

    /** An admin's decision may move these fields and nothing else. */
    function onlyDecides() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['decidedAt', 'decidedBy', 'outcome'])
             && request.resource.data.decidedBy == request.auth.uid;
    }

    /**
     * Allowed to write what this patient is prescribed. Three conditions, and
     * removing any one of them opens a hole:
     *
     *   verified   — the admin checked they are a clinician at all
     *   granted    — this patient gave them the medication permission
     *   role       — this patient meant them as a clinician, not a supporter
     *
     * Being a doctor somewhere is not the same as being *this* person's
     * doctor, and the patient's word is what settles it.
     */
    function isPrescriber(pid) {
      return isVerifiedClinician()
             && granted(pid, 'medication')
             && circleDoc(pid).role == 'clinician';
    }

    /*
     * The change log is what draws the vertical rules on the chart, and PRD
     * 6.6 calls those "the entire clinical value of the product". Shortening
     * it would erase a dose change that actually happened, so nobody may —
     * not the patient, not the clinician who wrote it.
     */
    /*
     * `memberUid` exists only so a clinician can find their patients with a
     * collection group query, which cannot filter on the document id. It is
     * therefore allowed to be absent, but never allowed to disagree with the
     * id — a card claiming to belong to someone else would put its patient in
     * that person's list without them ever being invited.
     */
    function honestMemberUid(memberUid) {
      return !('memberUid' in request.resource.data)
             || request.resource.data.memberUid == memberUid;
    }

    /*
     * Asking for a change, as opposed to making one.
     *
     * `pendingChange` must be the *only* field that moved — otherwise a
     * proposal would be a place to hide a real edit — and it must be signed
     * by the person writing it.
     */
    function onlyProposes() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingChange'])
             && request.resource.data.pendingChange.proposedBy == request.auth.uid;
    }

    function logOnlyGrows() {
      return request.resource.data.get('changeLog', []).size()
             >= resource.data.get('changeLog', []).size();
    }

    /*
     * Whether the clinician who owns this line is still there to change it.
     *
     * `resource` is the medication being updated, so `prescribedBy` names the
     * person who wrote it. Gone means either no circle entry at all — removed
     * outright — or an entry that has been revoked.
     *
     * Without this, revoking a psychiatrist froze every line they prescribed
     * permanently: the patient fails the self-edit branch because
     * `prescribedBy` is set, and the prescriber branch fails because
     * `granted()` is false once revoked. The only move left was to write a
     * `pendingChange` addressed to someone who could no longer read the
     * document it lived on.
     */
    function prescriberGone(pid) {
      return !exists(/databases/$(database)/documents/patients/$(pid)/circle/$(resource.data.prescribedBy))
             || get(/databases/$(database)/documents/patients/$(pid)/circle/$(resource.data.prescribedBy))
                  .data.get('revokedAt', null) != null;
    }

    /*
     * Taking a line back, as opposed to changing it.
     *
     * `prescribedBy` and the log may move, and a stale request addressed to
     * the departed clinician may be cleared at the same time. The dose may
     * not — otherwise releasing would be a way to edit a prescription without
     * any prescriber ever seeing it. Take it back, then change it, and the log
     * records both steps.
     */
    function onlyReleases() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['prescribedBy', 'pendingChange', 'changeLog']);
    }

    /*
     * Whether an invite names its recipient, and whether that is this person.
     *
     * An invite sent as a link is a bearer token on purpose: holding the code
     * is the capability, which is what sharing a link means. An invite issued
     * from the clinician directory is not — **nobody handed it over**. The
     * person searched, found a name, and asked. So the code alone must not be
     * enough there, or an invite meant for one psychiatrist would admit
     * whoever came across it.
     *
     * Absent on every invite written before this existed, hence `get` with a
     * null default: an old link keeps working exactly as it did.
     */
    function addressedToMe(code) {
      return inviteData(code).get('forUid', null) == null
             || inviteData(code).get('forUid', null) == request.auth.uid;
    }

    /**
     * A proposed circle entry is redeemable only if it matches an invite this
     * patient issued, exactly. Any deviation in role or permissions is a
     * privilege escalation attempt and is refused.
     */
    function redeemable(pid, proposed) {
      return proposed.inviteCode is string
             && exists(/databases/$(database)/documents/invites/$(proposed.inviteCode))
             && inviteData(proposed.inviteCode).patientId == pid
             && inviteData(proposed.inviteCode).expiresAt > request.time
             && (inviteData(proposed.inviteCode).usedBy == null
                 || inviteData(proposed.inviteCode).usedBy == request.auth.uid)
             && addressedToMe(proposed.inviteCode)
             && proposed.role == inviteData(proposed.inviteCode).role
             && proposed.permissions == inviteData(proposed.inviteCode).permissions;
    }

    // Identity and settings. Nothing clinical lives here.
    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      // Account deletion goes through the GDPR Art. 17 Cloud Function, which
      // cascades. A client-side delete would orphan the subtree.
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, create, update: if isSelf(patientId);
      allow delete: if false;

      /*
       * GDPR Art. 9 consent log. Append-only by design: a consent record that
       * can be erased is not a record. Withdrawal is an update that sets
       * withdrawnAt, never a delete.
       */
      /*
       * PRD 6.1 — one check-in per local calendar day, keyed by the date.
       *
       * The document id must equal the date field, which is what makes
       * one-per-day idempotent: an offline write that syncs twice lands on
       * the same document instead of creating a second entry for the day.
       *
       * The midnight lock is enforced in the client, not here. Security
       * rules have no timezone support, so they cannot tell what "today in
       * Brussels" is, and approximating it in UTC would lock the check-in an
       * hour early or late depending on the season. The boundary that
       * matters — nobody else can read or write this — is enforced.
       */
      match /checkins/{dateKey} {
        // Read resolves through the circle. Writing stays self-only: a
        // supporter must never be able to author how someone else felt.
        allow read: if canRead(patientId, 'checkins');
        allow create, update: if isSelf(patientId)
                              && request.resource.data.date == dateKey;
        // Erasing a day would leave a silent hole in the clinical record.
        // Deletion happens through the GDPR Art. 17 function, which cascades.
        allow delete: if false;
      }

      /*
       * PRD 5.3 and 6.7 — *what you are prescribed* is a clinical decision.
       *
       * A verified clinician the patient invited owns this list. The patient
       * keeps writing entries themselves — which is the only way the list can
       * exist before the psychiatrist has an account — but an entry a
       * clinician has taken over is no longer theirs to edit.
       *
       * `prescribedBy` carries that ownership, so the patient may never set
       * it: otherwise they could author provenance, and a line saying "your
       * doctor prescribed this" would not be worth reading.
       *
       * The counterpart is in `doses/` below and the line between them is the
       * one that must never blur: whether you took it is your own record, and
       * nobody writes it for you — not even the person who prescribed it.
       */
      match /medications/{medId} {
        allow read: if canReadClinical(patientId);

        allow create: if (isSelf(patientId)
                          && request.resource.data.get('prescribedBy', null) == null)
                      || (isPrescriber(patientId)
                          && request.resource.data.prescribedBy == request.auth.uid);

        /*
         * Three ways this entry changes, and which one applies depends on
         * whether a clinician owns it.
         *
         *   nobody prescribed it  → the patient edits it outright
         *   a clinician did       → the patient may only *ask*
         *   the prescriber        → applies, declines, edits
         *   the prescriber is gone → the patient may take it back
         *
         * "If there is a doctor assigned, they need to approve" is answered
         * by `prescribedBy`: a doctor is assigned to a prescription, and
         * that is a fact already on the document. Rules cannot query the
         * circle for "is there a clinician somewhere", and a flag saying so
         * would be written by the patient and therefore worth nothing.
         *
         * The fourth branch is what stops that answer becoming a trap. A
         * prescription outlives the circle entry that authorised it, so
         * without a way back a single revocation would freeze a line for
         * good — and the person it belongs to would be the one locked out.
         */
        allow update: if logOnlyGrows()
                      && ((isSelf(patientId)
                           && resource.data.get('prescribedBy', null) == null
                           && request.resource.data.get('prescribedBy', null) == null)
                          || (isSelf(patientId) && onlyProposes())
                          || (isPrescriber(patientId)
                              && request.resource.data.prescribedBy == request.auth.uid)
                          || (isSelf(patientId)
                              && resource.data.get('prescribedBy', null) != null
                              && request.resource.data.get('prescribedBy', null) == null
                              && onlyReleases()
                              && prescriberGone(patientId)));

        // Deleting a medication would erase the history of taking it.
        // Stopping one sets activeTo instead.
        allow delete: if false;
      }

      /*
       * A dose is keyed `yyyy-MM-dd_medId_HHmm`, so ticking it offline and
       * syncing twice records one dose rather than two.
       */
      match /doses/{doseKey} {
        // Whether you took it is as clinical as what you take. Family and
        // friends see neither.
        allow read: if canReadClinical(patientId);
        allow create, update: if isSelf(patientId);
        allow delete: if false;
      }

      /*
       * PRD 6.3, and the rule the calendar exists to express.
       *
       * A supporter with `calendar` may *offer* something — create it as
       * `suggested`, in their own name — and may change nothing afterwards.
       * Accepting is the patient's, declining is the patient's, and editing
       * is the patient's. Family wanting to help and a person needing to
       * control their own day is the central tension of this product, and a
       * supporter who could write straight onto the calendar would resolve it
       * the wrong way.
       *
       * **Declining is silent, and that is enforced here rather than by the
       * app being tactful:** a member cannot read a declined activity at all.
       * Their listing has to filter on status, so a query that would reveal
       * one is refused outright.
       */
      match /activities/{activityId} {
        allow get: if isSelf(patientId)
                   || (granted(patientId, 'calendar') && resource.data.status != 'declined');
        allow list: if isSelf(patientId)
                    || (granted(patientId, 'calendar') && resource.data.status != 'declined');

        allow create: if isSelf(patientId)
                      || (granted(patientId, 'calendar')
                          && request.resource.data.status == 'suggested'
                          && request.resource.data.createdBy == request.auth.uid);

        allow update: if isSelf(patientId);
        // Removing something from the day is declining it, which keeps the
        // record of what was offered without putting it on the calendar.
        allow delete: if false;
      }

      /*
       * What a person made of doing it. Self only, in both directions.
       *
       * PRD 5.3 does not give completions a row, so this takes the narrow
       * reading: pleasure and mastery are someone rating their own day, which
       * is the kind of thing the check-in permission covers, and they sit in
       * the same document as the fact of completion. Sharing a completion is
       * what the feed is for, deliberately and per item. Widening this later
       * is easy; narrowing it after a family has read someone's ratings is
       * not.
       */
      match /completions/{completionKey} {
        allow read, create, update: if isSelf(patientId);
        allow delete: if false;
      }

      match /weekly/{weekKey} {
        // The weekly items are check-in data, so they follow that permission.
        allow read: if canRead(patientId, 'checkins');
        allow create, update: if isSelf(patientId);
        allow delete: if false;
      }

      /*
       * PRD 5.3, the row that matters.
       *
       * The patient may read and write every entry. A member may read their
       * own entry — so a supporter can see what they were granted — and may
       * write **nothing at all**.
       *
       * This is what stops a family member widening their own access. Note
       * that `allow update: if isSelf(patientId)` is not merely "the member
       * cannot grant themselves more": the member cannot touch the document
       * in any way, so there is no field left to be clever with.
       *
       * Revocation is an update setting revokedAt, never a delete, so the
       * record of who once had access survives.
       */
      match /circle/{memberUid} {
        allow read: if isSelf(patientId) || isSelf(memberUid);

        /*
         * Redeeming an invite is the one way a circle entry appears without
         * the patient writing it, and it is fenced in hard: the entry must be
         * for yourself, must name an invite that is unused and unexpired and
         * belongs to *this* patient, and must carry **exactly** the role and
         * permissions the patient put in that invite.
         *
         * That last clause is the important one. Without it, a redeemer could
         * present a feed-only invite and write themselves a card granting
         * everything — the invite would be valid and the escalation total.
         *
         * PRD 5.4 puts this in a Cloud Function instead. Doing it in rules
         * keeps the project free of billing, and the invariant is enforced by
         * the database either way. A function would additionally guarantee
         * an invite is consumed exactly once even under a race; here that
         * relies on the client's transaction. Worth revisiting if invites are
         * ever more than a family handing each other a link.
         */
        allow create: if honestMemberUid(memberUid)
                      && clinicianIsVerified(memberUid)
                      && (isSelf(patientId)
                          || (isSelf(memberUid)
                              && request.resource.data.revokedAt == null
                              && redeemable(patientId, request.resource.data)));

        /*
         * The clamp applies to updates too. Without it a patient could write a
         * supporter card for someone and then edit it into a clinician one,
         * which is the same escalation by two writes.
         */
        allow update: if isSelf(patientId)
                      && honestMemberUid(memberUid)
                      && clinicianIsVerified(memberUid);
        allow delete: if false;
      }

      /*
       * PRD 6.4 — the feed. Scoped to this patient and their circle, and not
       * a network: there is nothing here to discover and nothing to follow
       * without being let in.
       *
       * Only the patient posts. A circle member granted `feed` may read, and
       * may react and comment — the two things a member is allowed to author
       * anywhere in this database, because warmth arriving from another human
       * is the point of the feature.
       */
      match /posts/{postId} {
        allow read: if canRead(patientId, 'feed');
        allow create, update: if isSelf(patientId);
        allow delete: if false;

        /*
         * One reaction per person per post, keyed by uid, so reacting twice
         * changes your mind rather than stacking. You may only write your
         * own: nobody applauds on somebody else's behalf.
         *
         * PRD 6.4 — warm only. The type is checked here as well as in the
         * client, because "no negative reaction exists" has to survive
         * someone posting straight to the database.
         */
        match /reactions/{memberUid} {
          allow read: if canRead(patientId, 'feed');
          allow create, update: if isSelf(memberUid)
                                && canRead(patientId, 'feed')
                                && request.resource.data.type in ['heart', 'clap', 'proud'];
          allow delete: if isSelf(memberUid);
        }

        match /comments/{commentId} {
          allow read: if canRead(patientId, 'feed');
          allow create: if canRead(patientId, 'feed')
                        && request.resource.data.authorUid == request.auth.uid;
          // A comment that can be edited after someone read it is not a
          // record of what was said. Removing your own is allowed.
          allow update: if false;
          allow delete: if isSelf(resource.data.authorUid) || isSelf(patientId);
        }
      }

      match /consents/{consentId} {
        allow read: if isSelf(patientId);
        /*
         * A consent record must carry the substantive agreement that applies
         * to this person, not merely exist.
         *
         * There are two, because there are two kinds of person here. Someone
         * keeping a logbook consents to their own Article 9 data. A supporter
         * or clinician stores no health data of their own — they are shown
         * somebody else's — so what they agree to is confidentiality. Asking
         * them for Article 9 consent would be meaningless and would hide the
         * obligation they actually take on.
         *
         * One of the two must be true. A record agreeing to neither is not
         * consent to anything and is refused.
         */
        allow create: if isSelf(patientId)
                      && request.resource.data.version is string
                      && request.resource.data.grants.essential == true
                      && (request.resource.data.grants.get('healthData', false) == true
                          || request.resource.data.grants.get('confidentiality', false) == true);
        allow update: if isSelf(patientId);
        allow delete: if false;
      }
    }

    /*
     * PRD 6.4 — invite codes. The code itself is the capability: knowing it
     * is what lets someone join, which is exactly how a shared link works.
     * So a signed-in person may read an invite they can name, and nothing
     * else about it is secret.
     *
     * Only the patient issues one. The redeemer may mark it used, once, and
     * may change nothing else — not the permissions it carries, not who it
     * belongs to.
     */
    match /invites/{code} {
      /*
       * `get` and `list` are split deliberately, and the split is the whole
       * security of the scheme.
       *
       * Naming a code is the capability — you can only name it if someone
       * sent it to you. Listing is not: a single `allow read` would let any
       * signed-in person enumerate every open invite in the system, pick one
       * belonging to a stranger, and redeem it. The invite would be genuine
       * and every other check would pass.
       *
       * So listing is restricted to the issuer, which also forces the query
       * to filter on patientId: a list that could return someone else's
       * invite is refused outright rather than filtered.
       */
      allow get: if signedIn();
      /*
       * The issuer, and the one person an addressed invite was written for.
       *
       * Widening `list` to the addressee forces their query to filter on
       * `forUid`, which is the same forcing that makes the issuer's listing
       * safe: a sweep that could return somebody else's invite is refused
       * rather than quietly trimmed. It is what lets a clinician see what has
       * been asked of them without a server and without an inbox collection.
       */
      allow list: if isSelf(resource.data.patientId)
                  || (signedIn() && resource.data.get('forUid', null) == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.usedBy == null;

      allow update: if
        // The patient may withdraw an invite by expiring it.
        (isSelf(resource.data.patientId)
          && request.resource.data.patientId == resource.data.patientId)
        // Or the redeemer claims it, exactly once, changing nothing else.
        //
        // `forUid` is pinned along with the rest, and the claim is refused to
        // anyone it was not written for. Without that second clause a stranger
        // holding the code could not join — the circle write would still stop
        // them — but they could burn the invite, and the doctor it was meant
        // for would find a dead code with nothing to say why.
        || (resource.data.usedBy == null
            && request.resource.data.usedBy == request.auth.uid
            && (resource.data.get('forUid', null) == null
                || resource.data.get('forUid', null) == request.auth.uid)
            && request.resource.data.patientId == resource.data.patientId
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions
            && request.resource.data.get('forUid', null) == resource.data.get('forUid', null)
            && request.resource.data.expiresAt == resource.data.expiresAt);

      allow delete: if isSelf(resource.data.patientId);
    }

    /*
     * PRD 6.7 — verified clinicians, checked manually by an admin.
     *
     * Readable by yourself so the console can tell you which side of the gate
     * you are on. Writable by nobody: verification is granted out of band,
     * with the admin SDK, and that is the whole point of it.
     */
    /*
     * Who is an admin. Bootstrapped with the Admin SDK and never in-band —
     * this is the single document class that keeps the whole chain honest.
     *
     * `get` is self-only so the app can tell whether to offer the panel;
     * `list` is refused, because who the admins are is nobody's business.
     */
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow write: if false;
    }

    /*
     * A clinician asking to be verified. They write their own application —
     * name, discipline, RIZIV number — and an admin decides.
     *
     * Applying grants nothing whatsoever. It is a request to be looked at by a
     * person, and until that person acts it has no effect anywhere.
     */
    match /clinicianRequests/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Applying for yourself, undecided. Nobody applies on another's behalf,
      // and nobody arrives pre-approved.
      allow create: if isSelf(uid)
                    && request.resource.data.outcome == null
                    && request.resource.data.decidedBy == null;

      allow update: if (isSelf(uid)
                        && resource.data.outcome == null
                        && request.resource.data.outcome == null
                        && request.resource.data.decidedBy == null)
                    || (isAdmin() && onlyDecides());

      // A decided request is kept. Who asked to be trusted with somebody
      // else's clinical record is not a thing this project erases.
      allow delete: if false;
    }

    /*
     * How a person finds their doctor. The document id is the connection code.
     *
     * `get` and `list` are split for the same reason invites are (D17): naming
     * a code is the capability — that is what a card handed across a desk is —
     * while listing is a different act. Restricting `list` to `listed == true`
     * forces the query to filter on it, so an unfiltered sweep is **refused
     * rather than quietly filtered**, and a clinician who does not want to be
     * searchable is not in anybody's result set.
     *
     * Nothing here is patient data. A name, a discipline, a practice — the
     * same as a nameplate on a door.
     */
    match /clinicianDirectory/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.listed == true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /clinicians/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      /*
       * Written by an admin, from the panel, and signed with their own uid.
       * A clinician still cannot verify themselves — unless they are also an
       * admin, which is a thing only the Admin SDK can make true.
       */
      allow create, update: if isAdmin()
                            && request.resource.data.verifiedBy == request.auth.uid;

      // Withdrawing verification is an admin act like granting it. The circle
      // reads resolve through `exists()`, so this takes effect immediately.
      allow delete: if isAdmin();
    }

    /*
     * How a clinician finds the patients who granted them access, without a
     * server: a collection group query over every circle, filtered to their
     * own entry.
     *
     * The filter is not a convenience — the rule is evaluated per returned
     * document, so a query that could return somebody else's card is refused
     * outright rather than quietly trimmed.
     *
     * It has to be a field rather than `isSelf(memberUid)`, which is what you
     * would write first: **inside a collection group match the document-id
     * wildcard is null**, and touching it fails the whole rule with a null
     * value error. `resource.data` is available; the path segments after
     * `{path=**}` are not. So `memberUid` duplicates the document id, and the
     * circle rules above refuse a write where the two disagree — otherwise
     * anyone could put a clinician's uid on their own card and appear in that
     * clinician's patient list uninvited.
     */
    match /{path=**}/circle/{memberUid} {
      allow list: if signedIn() && resource.data.memberUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
