rules_version = '2';

/*
 * PRD 5.3 — the circle document IS the access control list. Every read of
 * patient data resolves through it.
 *
 * The rule that matters most: **circle/** is writable by the patient only.**
 * A family member must never be able to widen their own access, and during an
 * episode the temptation to do so is real. Read the `circle` match block with
 * that sentence in mind; everything else here is detail.
 *
 * Default deny is the last match in the file. Anything not named is refused.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** The reader's own entry in this patient's circle, or null. */
    function circleDoc(pid) {
      return get(/databases/$(database)/documents/patients/$(pid)/circle/$(request.auth.uid)).data;
    }

    function inCircle(pid) {
      return signedIn()
             && exists(/databases/$(database)/documents/patients/$(pid)/circle/$(request.auth.uid));
    }

    /*
     * Granted only while the membership is live and that specific permission
     * is on. Revocation sets revokedAt, so access ends the moment it is set
     * without deleting the record of it having existed.
     */
    function granted(pid, key) {
      return inCircle(pid)
             && circleDoc(pid).revokedAt == null
             && circleDoc(pid).permissions[key] == true;
    }

    /** Self, or a circle member the patient granted this specific key to. */
    function canRead(pid, key) {
      return isSelf(pid) || granted(pid, key);
    }

    function inviteData(code) {
      return get(/databases/$(database)/documents/invites/$(code)).data;
    }

    /**
     * A proposed circle entry is redeemable only if it matches an invite this
     * patient issued, exactly. Any deviation in role or permissions is a
     * privilege escalation attempt and is refused.
     */
    function redeemable(pid, proposed) {
      return proposed.inviteCode is string
             && exists(/databases/$(database)/documents/invites/$(proposed.inviteCode))
             && inviteData(proposed.inviteCode).patientId == pid
             && inviteData(proposed.inviteCode).expiresAt > request.time
             && (inviteData(proposed.inviteCode).usedBy == null
                 || inviteData(proposed.inviteCode).usedBy == request.auth.uid)
             && proposed.role == inviteData(proposed.inviteCode).role
             && proposed.permissions == inviteData(proposed.inviteCode).permissions;
    }

    // Identity and settings. Nothing clinical lives here.
    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      // Account deletion goes through the GDPR Art. 17 Cloud Function, which
      // cascades. A client-side delete would orphan the subtree.
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, create, update: if isSelf(patientId);
      allow delete: if false;

      /*
       * GDPR Art. 9 consent log. Append-only by design: a consent record that
       * can be erased is not a record. Withdrawal is an update that sets
       * withdrawnAt, never a delete.
       */
      /*
       * PRD 6.1 — one check-in per local calendar day, keyed by the date.
       *
       * The document id must equal the date field, which is what makes
       * one-per-day idempotent: an offline write that syncs twice lands on
       * the same document instead of creating a second entry for the day.
       *
       * The midnight lock is enforced in the client, not here. Security
       * rules have no timezone support, so they cannot tell what "today in
       * Brussels" is, and approximating it in UTC would lock the check-in an
       * hour early or late depending on the season. The boundary that
       * matters — nobody else can read or write this — is enforced.
       */
      match /checkins/{dateKey} {
        // Read resolves through the circle. Writing stays self-only: a
        // supporter must never be able to author how someone else felt.
        allow read: if canRead(patientId, 'checkins');
        allow create, update: if isSelf(patientId)
                              && request.resource.data.date == dateKey;
        // Erasing a day would leave a silent hole in the clinical record.
        // Deletion happens through the GDPR Art. 17 function, which cascades.
        allow delete: if false;
      }

      /*
       * PRD 5.3 — medication is the one thing a verified clinician may write
       * once the console exists (Phase 7). Until then it is the patient's own
       * list, and the changeLog is appended from the very first edit so the
       * chart has something to mark.
       */
      match /medications/{medId} {
        allow read: if canRead(patientId, 'medication');
        allow create, update: if isSelf(patientId);
        // Deleting a medication would erase the history of taking it.
        // Stopping one sets activeTo instead.
        allow delete: if false;
      }

      /*
       * A dose is keyed `yyyy-MM-dd_medId_HHmm`, so ticking it offline and
       * syncing twice records one dose rather than two.
       */
      match /doses/{doseKey} {
        allow read: if canRead(patientId, 'medication');
        allow create, update: if isSelf(patientId);
        allow delete: if false;
      }

      match /weekly/{weekKey} {
        // The weekly items are check-in data, so they follow that permission.
        allow read: if canRead(patientId, 'checkins');
        allow create, update: if isSelf(patientId);
        allow delete: if false;
      }

      /*
       * PRD 5.3, the row that matters.
       *
       * The patient may read and write every entry. A member may read their
       * own entry — so a supporter can see what they were granted — and may
       * write **nothing at all**.
       *
       * This is what stops a family member widening their own access. Note
       * that `allow update: if isSelf(patientId)` is not merely "the member
       * cannot grant themselves more": the member cannot touch the document
       * in any way, so there is no field left to be clever with.
       *
       * Revocation is an update setting revokedAt, never a delete, so the
       * record of who once had access survives.
       */
      match /circle/{memberUid} {
        allow read: if isSelf(patientId) || isSelf(memberUid);

        /*
         * Redeeming an invite is the one way a circle entry appears without
         * the patient writing it, and it is fenced in hard: the entry must be
         * for yourself, must name an invite that is unused and unexpired and
         * belongs to *this* patient, and must carry **exactly** the role and
         * permissions the patient put in that invite.
         *
         * That last clause is the important one. Without it, a redeemer could
         * present a feed-only invite and write themselves a card granting
         * everything — the invite would be valid and the escalation total.
         *
         * PRD 5.4 puts this in a Cloud Function instead. Doing it in rules
         * keeps the project free of billing, and the invariant is enforced by
         * the database either way. A function would additionally guarantee
         * an invite is consumed exactly once even under a race; here that
         * relies on the client's transaction. Worth revisiting if invites are
         * ever more than a family handing each other a link.
         */
        allow create: if isSelf(patientId)
                      || (isSelf(memberUid)
                          && request.resource.data.revokedAt == null
                          && redeemable(patientId, request.resource.data));

        allow update: if isSelf(patientId);
        allow delete: if false;
      }

      match /consents/{consentId} {
        allow read: if isSelf(patientId);
        allow create: if isSelf(patientId)
                      && request.resource.data.version is string
                      && request.resource.data.grants.essential == true
                      && request.resource.data.grants.healthData == true;
        allow update: if isSelf(patientId);
        allow delete: if false;
      }
    }

    /*
     * PRD 6.4 — invite codes. The code itself is the capability: knowing it
     * is what lets someone join, which is exactly how a shared link works.
     * So a signed-in person may read an invite they can name, and nothing
     * else about it is secret.
     *
     * Only the patient issues one. The redeemer may mark it used, once, and
     * may change nothing else — not the permissions it carries, not who it
     * belongs to.
     */
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.usedBy == null;

      allow update: if
        // The patient may withdraw an invite by expiring it.
        (isSelf(resource.data.patientId)
          && request.resource.data.patientId == resource.data.patientId)
        // Or the redeemer claims it, exactly once, changing nothing else.
        || (resource.data.usedBy == null
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.patientId == resource.data.patientId
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions
            && request.resource.data.expiresAt == resource.data.expiresAt);

      allow delete: if isSelf(resource.data.patientId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
